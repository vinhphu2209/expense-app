# Copy to .env.local and fill in. Never commit .env.local.
# Every variable here must also exist in src/env.ts and docs/operations/environments.md §2.

# Environment label shown in the UI badge: development | uat | production
NEXT_PUBLIC_APP_ENV=development

# Supabase — local values come from `pnpm db:status` after `pnpm db:start`:
#   API_URL → NEXT_PUBLIC_SUPABASE_URL, PUBLISHABLE_KEY → …_PUBLISHABLE_KEY, SECRET_KEY → SUPABASE_SECRET_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-PUBLISHABLE_KEY-from-pnpm-db-status

# Server-only. Bypasses RLS. Never expose to the browser or logs.
SUPABASE_SECRET_KEY=paste-SECRET_KEY-from-pnpm-db-status
