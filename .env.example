# Copy to .env.local and fill in. Never commit .env.local.
# Every variable here must also exist in src/env.ts and docs/operations/environments.md §2.

# Environment label shown in the UI badge: development | uat | production
NEXT_PUBLIC_APP_ENV=development

# Supabase (local values are printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server-only. Never expose to the browser or logs.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
