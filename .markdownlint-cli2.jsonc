// Docs lint config (docs/conventions/documentation.md). Wired into CI in P0-00b.
{
  "config": {
    "default": true,
    "MD013": false, // line length: prose is not hard-wrapped
    "MD033": false, // inline HTML (PR template comments)
    "MD041": false, // command/workflow files start with front matter
    "MD024": { "siblings_only": true }
  },
  "ignores": ["node_modules/**", ".next/**"]
}
